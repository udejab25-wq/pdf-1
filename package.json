{
  "name": "pdf-studio",
  "version": "1.1.0",
  "description": "PDF editor and converter for Windows, macOS, Linux, Android and the web",
  "author": "PDF Studio",
  "homepage": "https://example.com",
  "main": "main.js",
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "serve": "npx serve www",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "android:add": "cap add android && cap sync android",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@pdf-lib/fontkit": "1.1.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "jszip": "3.10.1",
    "mammoth": "1.6.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "xlsx": "0.18.5"
  },
  "build": {
    "appId": "com.example.pdfstudio",
    "productName": "PDF Studio",
    "files": ["main.js", "www/**"],
    "extraResources": [{ "from": "backend", "to": "backend" }],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "category": "Office" }
  }
}
